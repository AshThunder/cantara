# Ledger mode: canton (default) or demo (in-memory fallback)
LEDGER_MODE=canton

# 5N Sandbox JSON Ledger API (from Seaport Sandbox Validator Access PDF)
CANTON_LEDGER_URL=https://ledger-api.validator.devnet.sandbox.fivenorth.io
CANTON_AUTH_URL=https://auth.sandbox.fivenorth.io/application/o/token/
CANTON_CLIENT_ID=validator-devnet-m2m
CANTON_CLIENT_SECRET=your-secret-from-pdf

# Auth uses: grant_type=client_credentials, audience=validator-devnet-m2m, scope=daml_ledger_api
# Token expires every 8 hours — backend auto-refreshes.

# Deployed cantara package
CANTON_PACKAGE_ID=b011f10b002d597291b67192a3c6c036a5ea9c7387726718292833d2c3cf3f58

# Authorized operator party (actAs) until Loop party is allocated
CANTON_OPERATOR_PARTY=5nsandbox-devnet-2::1220a14ca128063b8dc9d1ebb0bd22633be9f2168500f4dbc1ecaeb1855b14e5acf8

# Map UI parties → Canton party IDs (defaults to operator party for all)
# CANTON_PARTY_ALICE=5nsandbox-devnet-2::1220...
# CANTON_PARTY_BOB=...
# Or JSON: CANTON_PARTIES_JSON={"Alice":"party::id","Bob":"party::id"}

# CORS — set after Vercel deploy
FRONTEND_URL=https://your-app.vercel.app

PORT=3001
